---
// Aquí definimos las variables que el componente espera recibir
const { titulo, descripcion, tecnologias } = Astro.props;
---

<div
    class="border border-gray-200 bg-white p-6 rounded-sm shadow-sm hover:shadow-md transition-shadow duration-300"
>
    <h3 class="text-xl font-bold text-gray-900 mb-2">{titulo}</h3>
    <p class="text-gray-600 mb-4 text-sm">{descripcion}</p>

    <div class="flex flex-wrap gap-2 mt-4">
        {
            tecnologias.map((tech) => (
                <span class="bg-gray-100 text-gray-800 text-xs font-semibold px-2.5 py-0.5 rounded border border-gray-300">
                    {tech}
                </span>
            ))
        }
    </div>
</div>
