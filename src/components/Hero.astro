---
// Módulo de Introducción
---

<section
    class="min-h-screen flex items-center justify-center bg-white px-6 py-20 border-b border-gray-200"
>
    <div
        class="max-w-6xl w-full grid grid-cols-1 md:grid-cols-2 gap-12 items-center"
    >
        <!-- Textos -->
        <div class="flex flex-col space-y-6">
            <h1
                class="text-5xl md:text-7xl font-bold tracking-tight text-black"
            >
                Cristóbal de la Piedra
            </h1>
            <h2 class="text-xl md:text-3xl font-medium text-gray-600">
                Full-stack Python Developer<br />& AI Architect
            </h2>
            <p class="text-lg text-gray-500 max-w-md">
                "Construyendo arquitecturas modulares, sistemas RAG y soluciones
                escalables, un bloque a la vez."
            </p>
            <a
                href="#portafolio"
                class="bg-black text-white px-8 py-4 w-max rounded-sm font-semibold hover:bg-gray-800 transition duration-300"
            >
                Ver Proyectos
            </a>
        </div>

        <!-- Imagen -->
        <div class="flex justify-center md:justify-end">
            <div class="relative w-full max-w-md">
                <!-- Decoración modular trasera -->
                <div
                    class="absolute -inset-4 border-2 border-gray-200 rounded-lg -z-10 transform translate-x-4 translate-y-4"
                >
                </div>

                <img
                    src="/207cbdb0-6d56-44b2-9a2f-b553a860aaa0.jpeg"
                    alt="Retrato"
                    class="rounded-lg shadow-xl w-full object-cover grayscale hover:grayscale-0 transition duration-700 ease-in-out"
                />
            </div>
        </div>
    </div>
</section>
